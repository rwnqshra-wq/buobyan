# ==============================================================
# إعدادات السيرفر الخلفي وقاعدة البيانات (Render / Local Server)
# ==============================================================

# 1. كلمة مرور لوحة التحكم (Admin Dashboard Password)
ADMIN_PASSWORD=admin123

# 2. رابط الاتصال بقاعدة بيانات MongoDB (MongoDB Atlas Connection URI)
# استبدل <username> و <password> و <cluster> ببيانات قاعدة بياناتك
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 3. اسم قاعدة البيانات داخل MongoDB (اختياري، الافتراضي: boubyan)
MONGODB_DB_NAME=boubyan

# 4. منفذ السيرفر (Port) - في Render يُحدد تلقائياً، ومحلياً 3000 أو 5173
PORT=3000

# 5. بيئة التشغيل
NODE_ENV=production


# ==============================================================
# إعدادات الواجهة الأمامية (Netlify / Vercel / Lovable)
# ==============================================================

# 6. رابط السيرفر الخلفي للواجهة (Backend API URL)
# - اتركه فارغاً إذا كان السيرفر والواجهة يعملان معاً على Render
# - إذا رفعت الواجهة على Netlify أو Vercel أو Lovable، ضع رابط سيرفر Render هنا:
VITE_API_URL=https://your-backend-app.onrender.com
